[Unit]
Description=GateTest scan-queue worker tick
After=network.target gatetest-web.service

[Service]
Type=oneshot
# Invoked through bash rather than exec'd directly, so the timer does not
# depend on the file's executable bit surviving a deploy. `git reset --hard`
# restores the mode recorded in the index, and this repo is authored on
# Windows where core.filemode is off — tick.sh was committed 100644 and every
# deploy would have silently stripped +x, leaving the unit failing with
# EACCES. The index is now 100755 as well; this is the belt to that braces.
ExecStart=/bin/bash /opt/gatetest/scripts/deploy/tick.sh /api/scan/worker/tick
# Admin secrets panel (docs/ops/secrets-panel.md): no helper unit may read or
# write the rendered secrets. Every unit here runs as root, so ownership alone
# cannot keep it out — this mount-namespace rule does. The web instances are
# unaffected: systemd itself (PID 1) reads their EnvironmentFile.
InaccessiblePaths=-/var/lib/gatetest/unit-env
