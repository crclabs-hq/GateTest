[Unit]
Description=GateTest — watch the admin secrets panel's rendered env file
Documentation=file:///opt/gatetest/docs/ops/secrets-panel.md

[Path]
# The web app writes this file atomically (tmp + fsync + rename) when a secret
# is set, deleted or applied in /admin/secrets. A change starts the oneshot
# below, which runs the blue/green restart. The web process itself never
# restarts anything and never needs sudo.
PathChanged=/var/lib/gatetest/unit-env/platform.env
Unit=gatetest-secrets-apply.service

[Install]
WantedBy=multi-user.target
