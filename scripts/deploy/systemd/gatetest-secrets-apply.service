[Unit]
Description=GateTest — restart web (blue/green) onto a changed platform.env
Documentation=file:///opt/gatetest/docs/ops/secrets-panel.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Same user as gatetest-pull-deploy.service, for the same reason: the
# blue/green restart drives systemctl and the proxy's dynamic file.
User=root
TimeoutStartSec=2400
# Invoked through bash so the unit does not depend on the file's executable
# bit surviving a deploy (same reasoning as gatetest-pull-deploy.service).
ExecStart=/bin/bash /opt/gatetest/scripts/deploy/secrets-apply.sh
# This unit restarts the web instances; it has no business reading or
# writing the rendered secrets. systemd (PID 1) reads platform.env for
# gatetest-web@.service, not this process, so hiding the directory from it
# costs nothing. No EnvironmentFile: it needs no credentials.
InaccessiblePaths=-/var/lib/gatetest/unit-env
StandardOutput=journal
StandardError=journal
