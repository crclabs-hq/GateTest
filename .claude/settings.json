{
  "permissions": {
    "allow": [
      "Bash(npm*)",
      "Bash(npx*)",
      "Bash(git*)",
      "Bash(bun*)",
      "Bash(bash /opt/jarvis/scripts/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/sweep.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
