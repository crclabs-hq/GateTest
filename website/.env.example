# Stripe
STRIPE_SECRET_KEY=sk_test_...
# From the Stripe dashboard webhook endpoint (Developers → Webhooks → signing secret).
# REQUIRED in production — webhook verification is fail-closed: without it every
# Stripe event is rejected with 401 and paid scans never start.
STRIPE_WEBHOOK_SECRET=whsec_...

# Email delivery (Resend.com API key). REQUIRED for the MCP $29/mo tier —
# without it the subscriber is charged but their gtmcp_ API key email silently
# never sends. Also used for scan-report digests.
RESEND_API_KEY=
# Provider switch for every e-mail the site sends (app/lib/mail-transport.js):
# `resend` | `tallrig` (`vapron`, the pre-rename name, is a deprecated alias). Unset → Resend while RESEND_API_KEY is configured.
MAIL_PROVIDER=
# From address for both providers (RESEND_FROM is honoured as the legacy name).
MAIL_FROM=

# Continuous tier monthly AI-review allowance in USD (default 10 if unset)
CONTINUOUS_AI_BUDGET_USD=10

# Public
NEXT_PUBLIC_BASE_URL=https://gatetest.io

# Gluecron (primary git host)
GLUECRON_BASE_URL=https://gluecron.com
GLUECRON_API_TOKEN=glc_...
GLUECRON_API_URL=https://gluecron.com/api
GLUECRON_TOKEN=glc_...

# GitHub App (dual-host — GitHub Marketplace distribution)
GATETEST_APP_ID=
GATETEST_PRIVATE_KEY=
# The App webhook's signing secret — what /api/webhook (app/lib/github-events.js)
# verifies X-Hub-Signature-256 against, and what /status reads (by name only) to
# call the webhooks "configured". Missing → every delivery is refused with 503.
# GATETEST_WEBHOOK_SECRET below is the OLD standalone app-server's name
# (src/app-server.js); the Next app never reads it.
GITHUB_WEBHOOK_SECRET=
GATETEST_WEBHOOK_SECRET=
GATETEST_GITHUB_TOKEN=
GIT_HOST=github

# GitHub Marketplace listing's own webhook (marketplace_purchase / ping —
# NOT the App's push/PR webhook above). Set on the listing's Webhook page,
# typed by Craig on the box AND in the listing — never in chat. Missing →
# /api/marketplace/webhook fails closed with 503.
GITHUB_MARKETPLACE_WEBHOOK_SECRET=

# Social OAuth — customer login (GitHub + GitLab + Google)
# SESSION_SECRET is shared across all three providers (high-entropy random string)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Redirect URI: https://gatetest.io/api/auth/gitlab/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI: https://gatetest.io/api/auth/google/callback
SESSION_SECRET=

# Admin
GATETEST_ADMIN_PASSWORD=change_me_before_deploy
GATETEST_ADMIN_USERNAMES=
# Comma-separated owners/orgs whose repos scan in admin mode without an API
# call (website/app/lib/github-callback.js fetchRepoMode).
GATETEST_ADMIN_ORGS=
GATETEST_API_KEY=
# HMAC key for the homepage self-scan badge: CI (scripts/publish-self-scan.js,
# secret GATETEST_INTERNAL_TOKEN on the repo) signs each publish with it and
# POST /api/internal/self-scan-status verifies. Unset on the site -> 503 on
# every publish and the badge shows the last committed measurement, dated.
GATETEST_INTERNAL_TOKEN=
# USER COMMUNICATION (Bible Boss Rule) — e-mails opted-in customers when a new
# CLI version ships (POST /api/releases/notify, curled from publish.yml).
# Ships OFF by default: anything other than the exact string "1" is disabled,
# including unset. Craig sets this AND the matching repo variable of the same
# name before a release should notify anyone.
GATETEST_RELEASE_NOTIFY_ENABLED=
# Vercel Cron auth — set to any random secret; Vercel sends it as "Authorization: Bearer <value>"
# REQUIRED in production: /api/watches/tick and /api/scan/worker/tick fail closed
# (reject every request) when this is unset — they no longer accept unauthenticated
# ticks. Set this before/immediately after deploying, or continuous-scan tick
# processing stops firing entirely.
CRON_SECRET=

# AI
ANTHROPIC_API_KEY=

# Route every Anthropic call through a proxy, corporate gateway, or a
# Bedrock/Vertex front-end. Leave blank for the real API
# (https://api.anthropic.com). A path prefix is supported and preserved:
# https://gateway.example.com/anthropic -> .../anthropic/v1/messages
# HTTPS only. A malformed value FAILS LOUDLY rather than falling back —
# silently shipping prompts to the vendor would defeat the reason for
# setting it (egress control, audit, data residency).
ANTHROPIC_BASE_URL=

# Pin the Anthropic API version header. Blank = 2023-06-01.
ANTHROPIC_VERSION=

# Multi-Agent Consensus (Nuclear tier opt-in only) — second-agent cross-check
OPENAI_API_KEY=

# Database (Neon serverless Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Build metadata (set by CI — no value needed locally)
APP_VERSION=
GIT_COMMIT=
# Set to 1 to emit `.next/standalone` (the Dockerfile does). Leave unset on the
# box: `next start` cannot serve a standalone build.
NEXT_OUTPUT_STANDALONE=

# SSH healing (optional — remote server access for auto-fix)
GATETEST_SSH_HOST=
GATETEST_SSH_PORT=22
GATETEST_SSH_USER=
GATETEST_SSH_PASSWORD=
GATETEST_SSH_KEY=

# Runtime / monitoring (optional — CLI and monitor daemon)
GATETEST_ADMIN_URL=https://gatetest.io/admin
GATETEST_ALERT_WEBHOOK=
GATETEST_REPORTS_DIR=.gatetest/reports
GATETEST_PURGE_WEBHOOK=
GATETEST_DEPLOY_HOOK=
GATETEST_RESTART_HOOK=
GATETEST_FIX_MAX_ATTEMPTS=3
GATETEST_CALLBACK_SECRET=
GATETEST_HMAC_SECRET=
GLUECRON_URL=https://gluecron.com
# Bearer for recipe WRITES (PUT /api/recipes) — the same token the CLI's
# remote recipe store sends. Unset → writes answer 503, never open
# (2026-08-18 audit: recipe poisoning).
GATETEST_RECIPE_STORE_TOKEN=

# Infrastructure tokens (optional — Vercel + Cloudflare for deploy hooks)
VERCEL_TOKEN=
CF_ZONE_ID=
CF_API_TOKEN=

# Admin API token (optional — machine-to-machine access)
ADMIN_TOKEN=

# SEO auto-submission — IndexNow protocol (optional)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Visit https://gatetest.io/<key>.txt to verify, then POST /api/admin/seo/submit
INDEXNOW_KEY=

# Marketing feature flags (optional — set to "1" to activate)
# NEXT_PUBLIC_LAUNCH_HN: shows a live HN launch-thread badge on marketing pages
# NEXT_PUBLIC_LIVE_COUNTER: shows a live scan counter (requires external feed)
NEXT_PUBLIC_LAUNCH_HN=
NEXT_PUBLIC_LIVE_COUNTER=

# Arena repo — owner/name of the gatetest-arena live demo. Used by
# /testing to render real-time inject-bug + AI-fix-PR activity. Default:
# crclabs-hq/gatetest-arena. Override only when running a fork.
ARENA_REPO=crclabs-hq/gatetest-arena

# ── The platform GateTest runs on and dispatches to: Tallrig (tallrig.com —
# renamed from Vapron 2026-09-14, "vapron is no longer"). Every hostname and
# the product name is read from website/app/lib/platform-config.js with the
# Tallrig values as defaults (measured live 2026-09-15); a further move is an
# env change here, never an edit to copy.
# Server-side precedence: TALLRIG_<NAME> → VAPRON_<NAME> (deprecated, pre-rename
# name — still read so an un-renamed box keeps working) → CRONTECH_<NAME> (legacy).
# The cutover on the box is written up in docs/ops/tallrig-cutover.md.
TALLRIG_BASE_URL=          # runtime-scan dispatch base (was VAPRON_BASE_URL)
TALLRIG_API_TOKEN=         # was VAPRON_API_TOKEN
TALLRIG_DISPATCH_SECRET=   # was VAPRON_DISPATCH_SECRET
TALLRIG_MAIL_URL=          # platform e-mail send endpoint, default https://tallrig.com/api/platform/email/send (was VAPRON_MAIL_URL)
TALLRIG_STATUS_URL=        # public health URL other products poll, default https://tallrig.com/api/health/status (was VAPRON_STATUS_URL)
PLATFORM_SERVICE_PREFIX=   # systemd unit prefix on the box, default tallrig (set vapron if the box's units are not renamed yet)
PLATFORM_CANONICAL_HOST=   # host the crontech.ai redirect must finally reach, default tallrig.com
# Client-visible (inlined at build — rebuild after changing):
NEXT_PUBLIC_PLATFORM_NAME=      # default Tallrig
NEXT_PUBLIC_PLATFORM_ENTITY=    # legal entity on /legal pages, default Tallrig Labs LLC
NEXT_PUBLIC_PLATFORM_ID=        # sibling id in /api/platform-status, default tallrig
NEXT_PUBLIC_PLATFORM_URL=       # default https://tallrig.com
NEXT_PUBLIC_PLATFORM_API_URL=   # default https://api.tallrig.com
