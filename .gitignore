# `node_modules` without the slash: the slash form matches only a DIRECTORY, so a
# symlinked node_modules (a worktree pointing at the main install) is NOT ignored
# and `git add -A` committed one into four commits on 2026-09-05.
node_modules
.gatetest/
coverage/
dist/
.env
*.pem
*.key
.DS_Store
.next/
website/.next/
website/node_modules/
website/test-results/
website/playwright-report/
vscode-extension/out/
vscode-extension/*.vsix

# Sub-agent worktrees (Agent tool with isolation: "worktree")
.claude/worktrees/

# Sandbox-delivered apply-*.js bundles — generated when the container
# proxy can't push, transferred to Craig's local machine for execution.
apply-*.js
.vercel
.env*

# Scan artifacts written by corpus runs — never commit these.
reliability-corpus/**/.gatetest/

# Runtime ledger for Tallrig push events (issue #672) — written by
# website/app/lib/tallrig-push-event-store.js, never checked in.
website/app/data/tallrig-push-events.jsonl

# ...but corpus fixtures MUST ship their .env.example. The known-good case
# modern-node-idioms uses a deliberately CRLF-encoded .env.example to guard
# the KI #49 false positive; if that file is not committed, CI runs without it
# and the guard silently tests nothing while the manifest ceilings no longer
# match. Re-include it explicitly.
!reliability-corpus/**/.env.example
