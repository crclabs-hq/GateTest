{
  "name": "gatetest",
  "displayName": "GateTest — Code Quality Gate",
  "description": "The code quality gate in your Problems panel. 121 analysis modules read the whole repository and put every finding on the line that caused it, ranked by what matters, each with the fix. Runs on your machine, free, no account. One click sends it to the hosted fix engine for a verified pull request. Per-scan pricing, charged at checkout.",
  "version": "1.1.3",
  "publisher": "GateTestHQ",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other",
    "Testing"
  ],
  "keywords": [
    "code quality",
    "quality gate",
    "linter",
    "static analysis",
    "security",
    "AI",
    "mcp"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crclabs-hq/GateTest"
  },
  "homepage": "https://gatetest.io",
  "bugs": {
    "url": "https://github.com/crclabs-hq/GateTest/issues"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gatetest.scanWorkspace",
        "title": "GateTest: Scan Workspace (Quick)",
        "icon": "$(shield)"
      },
      {
        "command": "gatetest.scanFull",
        "title": "GateTest: Scan Workspace (Full)",
        "icon": "$(verified)"
      },
      {
        "command": "gatetest.scanFile",
        "title": "GateTest: Scan This File",
        "icon": "$(search)"
      },
      {
        "command": "gatetest.cancelScan",
        "title": "GateTest: Cancel Running Scan",
        "icon": "$(stop-circle)"
      },
      {
        "command": "gatetest.fixIssues",
        "title": "GateTest: Fix Issues with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gatetest.fixFindingLocal",
        "title": "GateTest: Fix This Finding (your own key)",
        "icon": "$(wand)"
      },
      {
        "command": "gatetest.setProviderKey",
        "title": "GateTest: Set AI Provider Key (for local fixes)",
        "icon": "$(key)"
      },
      {
        "command": "gatetest.showPanel",
        "title": "GateTest: Show Issues Panel",
        "icon": "$(list-unordered)"
      },
      {
        "command": "gatetest.setupMcp",
        "title": "GateTest: Configure MCP Server for AI Tools (on request)"
      },
      {
        "command": "gatetest.addWorkspaceMcp",
        "title": "GateTest: Add MCP Server to this Workspace (.vscode/mcp.json)"
      },
      {
        "command": "gatetest.openDashboard",
        "title": "GateTest: Open Online Dashboard"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gatetest.scanFile",
          "group": "navigation",
          "when": "resourceLangId =~ /typescript|javascript|python|go|rust/"
        }
      ],
      "explorer/context": [
        {
          "command": "gatetest.scanWorkspace",
          "group": "gatetest"
        }
      ],
      "commandPalette": [
        {
          "command": "gatetest.scanWorkspace"
        },
        {
          "command": "gatetest.scanFull"
        },
        {
          "command": "gatetest.scanFile"
        },
        {
          "command": "gatetest.cancelScan"
        },
        {
          "command": "gatetest.fixIssues"
        },
        {
          "command": "gatetest.fixFindingLocal"
        },
        {
          "command": "gatetest.setProviderKey"
        },
        {
          "command": "gatetest.showPanel"
        },
        {
          "command": "gatetest.setupMcp"
        },
        {
          "command": "gatetest.addWorkspaceMcp"
        },
        {
          "command": "gatetest.openDashboard"
        }
      ],
      "editor/context": [
        {
          "command": "gatetest.fixFindingLocal",
          "group": "gatetest",
          "when": "resourceLangId =~ /typescript|javascript|python|go|rust/"
        }
      ]
    },
    "configuration": {
      "title": "GateTest",
      "properties": {
        "gatetest.suite": {
          "type": "string",
          "default": "quick",
          "enum": [
            "quick",
            "full",
            "nuclear"
          ],
          "description": "Default scan suite. quick = the fast pre-commit set, full = the whole engine that can run in an editor (mutation and chaos testing run in CI, never in the editor)."
        },
        "gatetest.autoScanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run a quick scan automatically when you save a file."
        },
        "gatetest.showInlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show GateTest findings as inline diagnostics in the editor."
        },
        "gatetest.apiBaseUrl": {
          "type": "string",
          "default": "https://gatetest.io",
          "description": "GateTest API base URL (leave as default unless self-hosting)."
        },
        "gatetest.enginePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the GateTest engine: a GateTest checkout or an installed @gatetest/cli package. Leave empty to use the workspace's own @gatetest/cli if present, else the copy bundled with the extension."
        },
        "gatetest.fixDepth": {
          "type": "string",
          "default": "standard",
          "enum": [
            "standard",
            "deep"
          ],
          "description": "standard = the engine's default model for fixes; deep = the most capable (slower, roughly 3x the cost per token). Used by \"Fix This Finding (your own key)\"; runs on your own AI provider key and you pay your provider directly."
        },
        "gatetest.fixMaxUsd": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Stop a local fix once its estimated spend passes this many US dollars (0 = no cap). Enforced between provider calls from the engine's price table, so the worst case is one in-flight call over the cap. If the resolved engine has no price table the cap cannot be enforced and the command says so before running."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gatetest",
          "title": "GateTest",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "gatetest": [
        {
          "id": "gatetest.issuesView",
          "name": "Issues",
          "icon": "$(shield)",
          "contextualTitle": "GateTest Issues"
        },
        {
          "id": "gatetest.modulesView",
          "name": "Modules",
          "contextualTitle": "GateTest Modules"
        }
      ]
    },
    "statusBar": [
      {
        "id": "gatetest.status",
        "name": "GateTest Status",
        "alignment": "right",
        "priority": 100
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.0.0"
  },
  "dependencies": {
    "@gatetest/cli": "^1.61.0"
  }
}
