# GateTest self-scan suppressions — every entry documents WHY.
# Format: module | module:rule | *:rule | module:rule@glob | path/**

# HomeEyesEarsHands renders marketing code snippets inside template literals.
# The localhost URLs are display text for customers, not endpoints this app
# calls — and a suppressor comment inside the template would render on the
# page. Scoped to this one file only.
hardcoded-url:localhost@website/app/components/HomeEyesEarsHands.tsx

# reliability-corpus/ is the INTENTIONAL known-bad code corpus the flywheel
# trainers learn from. Findings in it are the corpus working as designed,
# not defects in GateTest — counting them against the self-scan would be
# self-deception in the other direction.
reliability-corpus/**

# corpus/broken-sites/ is the deliberately-broken HTML fixture
# scripts/compare-playwright.js uses to measure GateTest's runtime-errors
# module against a hand-written Playwright capture (5 known bugs, by design:
# missing viewport meta, missing lang attribute, missing main landmark,
# missing meta description, etc.). Same rationale as reliability-corpus and
# benchmarks/bench-target below — a11y/visual/seo findings here are the
# fixture working as designed, not a defect in GateTest's own site. Verify
# the fixture still triggers these modules when scanned directly:
# `node bin/gatetest.js --project corpus/broken-sites --module accessibility`.
corpus/broken-sites/**

# benchmarks/bench-target/ is the frozen, deliberately-vulnerable target repo
# the competitive benchmark (docs/COMPETITIVE-BENCHMARK.md, KI #31/#46)
# measures GateTest and rival tools against. Its hardcoded secrets, eval(),
# SQL concatenation, parseFloat money math, etc. are the corpus doing its
# job — same rationale as reliability-corpus above. Discovered blocking the
# CI Pre-Merge Sweep 2026-07-23: the sweep step (added 2026-07-20) had never
# actually executed before, because CI's install step was broken from
# 2026-07-19 until today — the first real sweep run surfaced this gap.
benchmarks/bench-target/**

# integrations/husky/pre-push:97 — `( cd … && timeout 5 git pull … >/dev/null 2>&1 || true )`
# is the hook's best-effort cache refresh: capped at 5s, documented as "never
# blocks the push", and the push goes ahead on the previous cache either way.
# bashSafety is right that nothing tests the outcome; the outcome is
# deliberately irrelevant. Surfaced 2026-09-05 when bashSafety learned to open
# extensionless shell scripts (KI #106). Line 88's clone is NOT here — its
# outcome is tested on the next line and the rule downgrades it itself.
bashSafety:pipe-true@integrations/husky/pre-push
